    },
    "medium": {
      "$value": 500
    }
  },
  "icon": {
    "$description": "stroke-width is a CSS property, not only an SVG attribute, so icon stroke weight is controlled globally by token.",
    "size": {
      "$type": "dimension",
      "$value": "16px"
    },
    "stroke": {
      "$type": "number",
      "$value": 1.25
    }
  },
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": "80ms"
    },
    "fast": {
      "$value": "150ms"
    },
    "base": {
      "$value": "250ms"
    },
    "slow": {
      "$value": "400ms"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "$description": "There is deliberately no ease-in curve: it starts slow, delaying the moment the user is watching.",
    "enter": {
      "$value": [0.23, 1, 0.32, 1],
      "$description": "Entering decelerates into place."
    },
    "exit": {
      "$value": [0.23, 1, 0.32, 1],
      "$description": "Leaving also decelerates."
    },
    "move": {
      "$value": [0.77, 0, 0.175, 1],
      "$description": "For something moving or morphing on screen, rather than arriving or leaving."
    }
  },
  "spring": {
    "$type": "spring",
    "$description": "For movement that should feel physical rather than timed. CSS has no spring, so a linear() approximation is carried in $extensions.",
    "$value": {
      "stiffness": 400,
      "damping": 30,
      "mass": 0.6
    },
    "$extensions": {
      "dev.wabi-sabi": {
        "cssLinear": "linear(0, 0.006, 0.025, 0.101, 0.539, 0.826, 0.962, 1.019, 1.03, 1.024, 1.013, 1.005, 1)"
      }
    }
  },
  "distance": {
    "$type": "dimension",
    "$description": "Offsets for movement that accompanies a fade. Stays in px in CSS.",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    }
  }
